ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_PAPER=true
PAPER_TRADING_ENABLED=false
ALPACA_DATA_FEED=iex
ALLOWED_ORIGINS=http://localhost:5173
SNAPSHOT_CACHE_TTL_SECONDS=600

# Internal API key — must match VITE_API_KEY set on the frontend.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Public guest quota.
GUEST_SCREEN_LIMIT=3
GUEST_QUOTA_TTL_SECONDS=86400
GUEST_SESSION_COOKIE_NAME=stock_picker_guest
GUEST_SESSION_COOKIE_SECURE=false
GUEST_SESSION_COOKIE_SAMESITE=lax
WHITELISTED_IPS=
BYPASS_COOKIE_NAME=stock_picker_access
BYPASS_COOKIE_VALUE=

# Future Auth0 API validation settings.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_ALGORITHMS=RS256
